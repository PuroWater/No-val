# 模型提供方（provider）：当前实现 deepseek，可通过 MODEL_PROVIDER 切换
MODEL_PROVIDER=deepseek
# 通用模型变量（与 DEEPSEEK_* 互为别名，DEEPSEEK_* 优先保留兼容）
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# DeepSeek 提供方配置（第一个 provider，兼容保留）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
JWT_SECRET=change-me
PORT=3001
